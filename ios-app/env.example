# Optional override for the FastAPI voice/AR backend.
# If unset, the app derives http://<Expo-Metro-LAN-host>:8000 automatically
# (same Mac the phone already reaches for the JS bundle).
#
# Use an explicit URL when the backend is on another host or via ngrok:
#   EXPO_PUBLIC_API_URL=https://xxxx.ngrok-free.app
#
# Local demo (backend on the Expo host):
#   cd .. && MODEL_PROVIDER=mock uvicorn backend.main:app --host 0.0.0.0 --port 8000
#   cd ios-app && npx expo start --tunnel
EXPO_PUBLIC_API_URL=
